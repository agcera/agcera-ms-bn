{
  "name": "agcera-ms-bn",
  "version": "1.0.0",
  "main": "server.ts",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon -r tsconfig-paths/register server.ts",
    "db:migrate": "sequelize db:migrate",
    "db:seed": "sequelize db:seed:undo:all && sequelize db:seed:all",
    "db:rollback": "sequelize db:migrate:undo:all",
    "db:reset": "npm run db:rollback && npm run db:migrate  && npm run db:seed && npm run dev",
    "build": "tsc && tsc-alias",
    "start": "(node build/server.js >> ../bn-logs.txt 2>> ../bn-errors.txt) &",
    "build:docker": "make build_image",
    "test": "jest --runInBand",
    "lint": "eslint . --fix",
    "format": "prettier --write ."
  },
  "author": "Jean Gabriel & Shema Alain",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "cloudinary": "^2.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dompurify": "^3.1.3",
    "dotenv": "^17.3.1",
    "express": "^4.18.3",
    "html2canvas": "^1.4.1",
    "joi": "^18.1.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "nodemon": "^3.1.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "puppeteer": "^24.40.0",
    "sanitize-html": "^2.13.0",
    "sequelize": "^6.37.1",
    "tsoa": "^6.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/supertest": "^2.0.16",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "@types/sanitize-html": "^2.11.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "morgan": "^1.10.0",
    "prettier": "^3.2.5",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.1.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.6.2",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "volta": {
    "node": "22.22.2",
    "npm": "10.9.8"
  }
}
